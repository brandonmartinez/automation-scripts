# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Project .sh files default to zsh, which shfmt does not support.
[*.{sh,zsh}]
indent_style = space
indent_size = 4
ignore = true

[*.{bash,bats}]
indent_style = space
indent_size = 4

[media/photo-multicrop2.sh]
shell_variant = bash
ignore = false

[.squad/templates/skills/distributed-mesh/sync-mesh.sh]
shell_variant = bash
ignore = false

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
